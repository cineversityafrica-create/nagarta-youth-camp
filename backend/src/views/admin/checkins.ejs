<%- include('../partials/head', { title: 'Check-ins' }) %>
<%- include('../partials/sidebar', { page: 'checkins' }) %>

<main class="main-content p-4 md:p-8 min-h-screen bg-cream/30">
  <div class="mb-6">
    <h2 class="font-serif text-3xl font-semibold text-maroon italic">Check-in / Check-out Log</h2>
    <p class="text-sm text-maroon/50 mt-1"><%= logs.length %> recent event<%= logs.length === 1 ? '' : 's' %> · newest first</p>
  </div>

  <% if (logs.length === 0) { %>
    <div class="bg-white rounded-xl border border-beige p-10 text-center text-maroon/50">No check-in events yet.</div>
  <% } else { %>
  <div class="bg-white rounded-xl border border-gray-100 shadow-sm overflow-hidden">
    <div class="table-container">
    <table class="w-full text-sm">
      <thead>
        <tr class="bg-gray-50 text-left text-xs uppercase tracking-wider text-maroon/50">
          <th class="px-4 py-3">Time</th>
          <th class="px-4 py-3">Event</th>
          <th class="px-4 py-3">Name</th>
          <th class="px-4 py-3">Reference</th>
          <th class="px-4 py-3">Guardian</th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody>
        <% logs.forEach(l => { %>
          <tr class="border-b border-gray-50 hover:bg-gray-50 cursor-pointer" onclick="toggleC('<%= l.id %>')">
            <td class="px-4 py-3 text-maroon/60 whitespace-nowrap"><%= new Date(l.at).toLocaleString('en-GB', { day:'numeric', month:'short', hour:'2-digit', minute:'2-digit' }) %></td>
            <td class="px-4 py-3">
              <span class="text-xs px-2.5 py-1 rounded-full font-bold <%= l.type === 'IN' ? 'bg-green-100 text-green-700' : 'bg-amber-100 text-amber-700' %>"><%= l.type === 'IN' ? 'Checked IN' : 'Checked OUT' %></span>
            </td>
            <td class="px-4 py-3 font-semibold text-maroon">
              <%= l.who %>
              <% if (l.kind === 'VOLUNTEER') { %><span class="ml-1 text-[10px] bg-emerald-50 text-emerald-700 border border-emerald-200 px-1.5 py-0.5 rounded">Volunteer</span><% } %>
              <% if (l.campId != null) { %><span class="ml-1 text-[10px] bg-beige text-burgundy px-1.5 py-0.5 rounded">#<%= l.campId %></span><% } %>
            </td>
            <td class="px-4 py-3 font-mono text-xs text-maroon/70"><%= l.referenceCode || '—' %></td>
            <td class="px-4 py-3 text-maroon/70"><%= l.guardianName || '—' %></td>
            <td class="px-4 py-3 text-right"><button type="button" onclick="event.stopPropagation();toggleC('<%= l.id %>')" class="text-xs text-gold font-semibold hover:underline">Details</button></td>
          </tr>
          <tr id="c-<%= l.id %>" style="display:none" class="bg-cream/40 border-b border-gray-100">
            <td colspan="6" class="px-6 py-5">
              <% if (l.kind === 'VOLUNTEER') { %>
                <p class="text-sm text-maroon/60 italic">Volunteer self check-<%= l.type === 'IN' ? 'in' : 'out' %> — no guardian details are collected.</p>
              <% } else { %>
                <dl class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-1.5 text-sm mb-4">
                  <div class="flex gap-2 py-1 border-b border-beige/40"><dt class="text-maroon/50 font-semibold min-w-[130px]">Guardian</dt><dd class="text-maroon flex-1"><%= l.guardianName || '—' %></dd></div>
                  <div class="flex gap-2 py-1 border-b border-beige/40"><dt class="text-maroon/50 font-semibold min-w-[130px]">Contact</dt><dd class="text-maroon flex-1"><%= l.guardianPhone || '—' %></dd></div>
                  <div class="flex gap-2 py-1 border-b border-beige/40"><dt class="text-maroon/50 font-semibold min-w-[130px]">Address</dt><dd class="text-maroon flex-1"><%= l.guardianAddress || '—' %></dd></div>
                  <div class="flex gap-2 py-1 border-b border-beige/40"><dt class="text-maroon/50 font-semibold min-w-[130px]">Ghana Card No.</dt><dd class="text-maroon flex-1 font-mono"><%= l.ghanaCard || '—' %></dd></div>
                </dl>
                <% if (l.ghanaCardFront || l.ghanaCardBack) { %>
                  <p class="text-xs uppercase tracking-wider text-maroon/50 font-semibold mb-2">Ghana Card Photos</p>
                  <div class="flex flex-wrap gap-4">
                    <% if (l.ghanaCardFront) { %>
                      <div><p class="text-[11px] text-maroon/50 mb-1">Front</p><a href="<%= l.ghanaCardFront %>" target="_blank" rel="noopener"><img src="<%= l.ghanaCardFront %>" alt="Ghana Card front" class="h-40 rounded-lg border border-beige hover:opacity-90 transition-opacity" /></a></div>
                    <% } %>
                    <% if (l.ghanaCardBack) { %>
                      <div><p class="text-[11px] text-maroon/50 mb-1">Back</p><a href="<%= l.ghanaCardBack %>" target="_blank" rel="noopener"><img src="<%= l.ghanaCardBack %>" alt="Ghana Card back" class="h-40 rounded-lg border border-beige hover:opacity-90 transition-opacity" /></a></div>
                    <% } %>
                  </div>
                  <p class="text-[11px] text-maroon/40 mt-1.5">Click a photo to open it full size.</p>
                <% } else { %>
                  <p class="text-xs text-maroon/40 italic">No Ghana Card photos on this record (captured from newer check-ins only).</p>
                <% } %>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    </div>
  </div>
  <% } %>
</main>

<script>
  function toggleC(id) {
    var el = document.getElementById('c-' + id);
    el.style.display = el.style.display === 'none' ? 'table-row' : 'none';
  }
</script>
</body>
</html>
